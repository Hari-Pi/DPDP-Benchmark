#!/usr/bin/env bash
# Point the Droidian DPDP relay at a temporary HTTPS endpoint from Colab.

set -euo pipefail

readonly RELAY_NAME="dpdp-colab-relay"
readonly RELAY_DIR="${DPDP_RELAY_DIR:-$HOME/dpdp-relay}"
readonly CONFIG_FILE="$RELAY_DIR/nginx.conf"
readonly TARGET_FILE="$RELAY_DIR/target-url"

usage() {
  echo "Usage: $0 <https://colab-endpoint> | off | status" >&2
}

status() {
  if [[ -s "$TARGET_FILE" ]]; then
    printf 'target: %s\n' "$(<"$TARGET_FILE")"
  else
    echo "target: not configured"
  fi
  docker ps --filter "name=^/${RELAY_NAME}$" \
    --format 'relay: {{.Status}} ({{.Ports}})'
  curl -fsS --max-time 5 http://127.0.0.1:8787/health || true
  echo
}

write_offline_config() {
  local destination="$1"
  {
    echo 'server {'
    echo '    listen 8080;'
    echo '    server_name _;'
    echo '    default_type application/json;'
    echo '    add_header Cache-Control "no-store" always;'
    echo '    return 503 '\''{"detail":"Colab DPDP backend is not connected"}'\'';'
    echo '}'
  } > "$destination"
}

write_proxy_config() {
  local destination="$1" target="$2" upstream_host="$3"
  {
    echo 'map $http_upgrade $connection_upgrade {'
    echo '    default upgrade;'
    echo "    '' close;"
    echo '}'
    echo
    echo 'server {'
    echo '    listen 8080;'
    echo '    server_name _;'
    echo '    client_max_body_size 10m;'
    echo
    echo '    location / {'
    printf '        proxy_pass %s;\n' "$target"
    printf '        proxy_set_header Host %s;\n' "$upstream_host"
    echo '        proxy_ssl_server_name on;'
    printf '        proxy_ssl_name %s;\n' "$upstream_host"
    echo '        proxy_http_version 1.1;'
    echo '        proxy_set_header Upgrade $http_upgrade;'
    echo '        proxy_set_header Connection $connection_upgrade;'
    echo '        proxy_set_header X-Real-IP $remote_addr;'
    echo '        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;'
    echo '        proxy_set_header X-Forwarded-Proto https;'
    echo '        proxy_buffering off;'
    echo '        proxy_request_buffering off;'
    echo '        proxy_connect_timeout 15s;'
    echo '        proxy_read_timeout 3600s;'
    echo '        proxy_send_timeout 3600s;'
    echo '    }'
    echo '}'
  } > "$destination"
}

[[ "$#" -eq 1 ]] || { usage; exit 2; }
mkdir -p "$RELAY_DIR"
temporary="$(mktemp "$RELAY_DIR/nginx.conf.XXXXXX")"
trap 'rm -f "$temporary"' EXIT

case "$1" in
  status)
    status
    exit
    ;;
  off)
    write_offline_config "$temporary"
    : > "$TARGET_FILE"
    ;;
  https://*)
    target="${1%/}"
    if [[ ! "$target" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~:/?\&=%+-]*)?$ ]]; then
      echo "Invalid HTTPS target URL" >&2
      exit 2
    fi
    upstream_host="${target#https://}"
    upstream_host="${upstream_host%%/*}"
    upstream_host="${upstream_host%%:*}"
    write_proxy_config "$temporary" "$target" "$upstream_host"
    printf '%s\n' "$target" > "$TARGET_FILE"
    ;;
  *)
    usage
    exit 2
    ;;
esac

cp "$CONFIG_FILE" "$CONFIG_FILE.previous" 2>/dev/null || true
mv "$temporary" "$CONFIG_FILE"
trap - EXIT

if ! docker exec "$RELAY_NAME" nginx -t; then
  [[ -f "$CONFIG_FILE.previous" ]] && mv "$CONFIG_FILE.previous" "$CONFIG_FILE"
  echo "Rejected invalid relay configuration" >&2
  exit 1
fi
docker exec "$RELAY_NAME" nginx -s reload
status
